{
  "name": "pw-bdd-automation",
  "version": "1.0.0",
  "description": "Playwright + Gherkin (BDD) test automation scaffold",
  "type": "commonjs",
  "scripts": {
    "bdd:gen": "bddgen",
    "test": "node scripts/run-tests.js",
    "test:headed": "node scripts/run-tests.js --headed",
    "test:ui": "node scripts/run-tests.js --ui",
    "test:debug": "node scripts/run-tests.js --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen"
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "playwright-bdd": "^9.2.0"
  }
}
